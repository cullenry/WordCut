# Copy this file to .env.local and fill in ONE key. Never commit .env.local.

# Transcription provider used by /api/transcribe.
# One of: deepgram (default) | assemblyai | openai
# OpenAI's Whisper tends to drop filler words, so "Clean up" finds fewer of them.
TRANSCRIPTION_PROVIDER=deepgram

# Spoken language code passed to the provider (default: en).
TRANSCRIPTION_LANGUAGE=en

# Audio sent for transcription: opus (default, ~9x smaller) or wav (lossless,
# more and smaller requests). Restart the dev server after changing.
NEXT_PUBLIC_TRANSCRIBE_AUDIO=opus

# The key for the provider you chose. Self-hosters only need one.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
