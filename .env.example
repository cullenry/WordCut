# Transcription provider used by /api/transcribe (added in step 2).
# One of: deepgram | assemblyai | openai
TRANSCRIPTION_PROVIDER=deepgram

# Spoken language code passed to the provider (default: en).
TRANSCRIPTION_LANGUAGE=en

# Audio sent for transcription: opus (default, ~9x smaller) or wav (lossless,
# more and smaller requests). Restart the dev server after changing.
NEXT_PUBLIC_TRANSCRIBE_AUDIO=opus

# Set the key for the provider you chose. Self-hosters only need one.
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=
OPENAI_API_KEY=
